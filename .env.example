# Klaviyo
KLAVIYO_API_KEY=

# EasyPost (legacy printable USPS returns — unused by the QR flow)
EASYPOST_API_KEY=

# Shippo (USPS Label Broker QR for "I need a new label")
SHIPPO_API_KEY=

# Shopify Storefront API
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STORE_DOMAIN=foto-foto-foto.myshopify.com
SCANS_VARIANT_ID=
PRINTS_VARIANT_ID=

# Wedding Box variants
WB_SCANS_VARIANT_ID=
WB_PRINTS_VARIANT_ID=

# Extra Prints add-on (standard developing)
EXTRA_PRINTS_VARIANT_ID=

# Prepaid developing redemption ($0 scans base + optional prints add-on)
PREPAID_SCANS_VARIANT_ID=51492473504044
PREPAID_PRINTS_VARIANT_ID=53995340300588

# SendCloud (international EU return labels)
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# Per-origin shipping method IDs (confirm in SendCloud dashboard)
SENDCLOUD_METHOD_FR=30396   # Mondial Relay Point Relais - Retour - QR (paperless)
SENDCLOUD_METHOD_IT=        # Chronopost 2Shop Retour Europe
SENDCLOUD_METHOD_GR=        # Chronopost 2Shop Retour Europe
# EU return hub (receiver of returns) — defaults to 12 rue des Halles, 75001 Paris
FF_RETURN_NAME=FOTO FOTO
FF_RETURN_COMPANY=FOTO FOTO
FF_RETURN_STREET=rue des Halles
FF_RETURN_HOUSE_NUMBER=12
FF_RETURN_CITY=Paris
FF_RETURN_POSTAL_CODE=75001
FF_RETURN_COUNTRY=FR
FF_RETURN_PHONE=
FF_RETURN_EMAIL=

# Vercel Blob (set automatically when linked on Vercel)
BLOB_READ_WRITE_TOKEN=
